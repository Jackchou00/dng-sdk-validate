# Disable line-ending conversion for vendored source and project files to preserve upstream formatting.
* -text

# Use LF for text files maintained by this repository.
README.md       text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.github/**      text eol=lf

# Binary assets: disable diff and text conversion.
*.dng      -text -diff
*.pdf      -text -diff
*.a        -text -diff
*.lib      -text -diff
*.tar      -text -diff
*.tar.gz   -text -diff
*.tar.bz2  -text -diff
